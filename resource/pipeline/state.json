{
    "State.Detect": {
        "doc": "Entry for the 'where am I' detector. The DetectState custom action (sxs/state.py) runs each node in custom_action_param.order against the same frame and stops at the first hit, so put popups and overlays before the screens they cover. (A plain next-list is not used because MaaFramework batches OCR across next-list nodes, which misread several screens.)",
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "DetectState",
        "custom_action_param": {
            "order": [
                "State.Agreement",
                "State.Loading",
                "State.Title",
                "State.Loading.Title",
                "State.RewardPopup",
                "State.Defeated",
                "State.ConfirmDialog",
                "State.Interact",
                "State.Dialogue",
                "State.BattlePrep",
                "State.Battle",
                "State.Home",
                "State.WorldOverview",
                "State.WorldMap",
                "State.Character",
                "State.MainMenu",
                "State.Quests",
                "State.Unknown"
            ]
        },
        "pre_delay": 0,
        "post_delay": 0
    },
    "State.Agreement": {
        "doc": "Publisher's first-run User Agreement dialog. Needs a human to accept.",
        "recognition": "OCR",
        "expected": "accept the User Agreement",
        "roi": [
            40,
            540,
            640,
            80
        ],
        "pre_delay": 0,
        "post_delay": 0
    },
    "State.Loading": {
        "doc": "The dark 'Loading...' screen, or 'Logging in...' over the title.",
