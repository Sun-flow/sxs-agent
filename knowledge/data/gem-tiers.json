  {"id": "rule-sockets", "kind": "rule", "text": "Sockets are per gear piece and open with that piece's enhancement level, one more per season, up to four. Season 2 anchor: two gems per piece once the piece reaches level 130.", "origin": "Prydwen build guides, as cited by eog", "sources": ["S-85"]},
  {"id": "rule-fusion", "kind": "rule", "text": "Fusion is 3 into 1 for the T1 and T2 steps, then 2 into 1 from T3 up. T1-T5 fuse from the inventory; from the T5 to T6 step on, fusion is done at the blacksmith NPC in Cinder Ridge.", "origin": "CN guide on TapTap, as cited by eog", "sources": ["S-85"]},
  {"id": "rule-success-rates", "kind": "rule", "text": "Success rates per band are 100% / 36% / 18% / 8% / 4%. A failure does not raise the odds; it fills a per-tier charge meter that guarantees a later attempt (meters are not shared between tiers). The T9 to T10 step needs 23 failures to fill.", "origin": "CN guide on TapTap, as cited by eog", "sources": ["S-85"]},
  {"id": "rule-ceiling", "kind": "rule", "text": "Practical ceiling is T12; T13-T15 exist as items but have not been seen live on CN.", "origin": "CN player reports, as cited by eog", "sources": ["S-85"]},
  {"id": "rule-meaning", "kind": "rule", "text": "Percentages scale the BASE attribute, not the final stat. One player measurement: a T4 Amber gave about 5,700 HP on a 680,000 HP character.", "origin": "eog", "sources": ["S-85"]},
  {"id": "rule-growth", "kind": "rule", "text": "Each tier is worth roughly 1.5x the previous one; a higher tier matters more than which gem of a pair is chosen.", "origin": "eog", "sources": ["S-85"]}
